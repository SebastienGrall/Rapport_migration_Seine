<<chunk fonction r_mig_inter et connexion base,echo=FALSE,eval=TRUE,results='hide'>>=
###### connexion à la base Stacomi, schéma Seinormigr ###########

# con<-  pool::dbPool(
#   drv=RPostgres::Postgres(),
#   dbname = keyring::key_get("dbname_server"),
#   host = keyring::key_get("host_server"),
#   port = keyring::key_get("port_server"),
#   user = keyring::key_get("user_server"),
#   password = keyring::key_get("pwd_server")
# )

if(exists("con")){

stacomi(database_expected = TRUE, sch= "seinormigr",options(
  stacomiR.dbname = keyring::key_get("dbname_server"),
  stacomiR.host = keyring::key_get("host_server"),
  stacomiR.port = keyring::key_get("port_server"),
  stacomiR.user = keyring::key_get("user_server"),
  stacomiR.password = keyring::key_get("pwd_server")))
  
### Fonction pour faire des r_mig_inter pour chaque espece (hors anguille) et DC ###
  
fn_rmiginter<-function(le_dc=c(101),espece=c("Alosa"),stade=c("5"),annee_debut=2008){
  
r_mig_interannual<-new("report_mig_interannual")
r_mig_interannual<-choice_c(r_mig_interannual,
                            dc=le_dc,
                            taxa=espece,
                            stage=stade,
                            start_year=annee_debut,
                            end_year=annee,
                            silent=TRUE)
r_mig_interannual<-charge(r_mig_interannual,silent=TRUE)
r_mig_interannual<-connect(r_mig_interannual,check=TRUE,silent=TRUE)	
r_mig_interannual<-calcule(r_mig_interannual,silent=TRUE)

return(r_mig_interannual)
}}

@

<<chunk data alose,echo=FALSE,eval=TRUE,results='hide'>>=
# data alose

if(exists("con")){

r_mig_inter_ala_poses<-fn_rmiginter(le_dc=c(101,103,105),espece=c("Alosa"),stade=c("5"),annee_debut = 2008)
r_mig_inter_ala_carandeau<-fn_rmiginter(le_dc=c(106,107),espece=c("Alosa"),stade=c("5"),annee_debut = 2018)
r_mig_inter_ala_pontoise<-fn_rmiginter(le_dc=c(108),espece=c("Alosa"),stade=c("5"),annee_debut = 2023)

data_alose<-c(r_mig_inter_ala_poses,r_mig_inter_ala_carandeau,r_mig_inter_ala_pontoise)
rm(r_mig_inter_ala_poses,r_mig_inter_ala_carandeau,r_mig_inter_ala_pontoise)

}

