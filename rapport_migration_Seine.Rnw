                           "Petromyzon marinus","Chelon ramada"))

mig_ang_poses_piege<-subset(data_ang[[1]]@data,bjo_labelquantite=="Effectif_total" & bjo_annee==annee)
mig_ang_poses_piege<-summarise(group_by(mig_ang_poses_piege,bjo_tax_code,bjo_std_code,bjo_dis_identifiant),effectifs=round(sum(bjo_valeur)))
mig_ang_poses_piege$bjo_std_code<-"CIV"
mig_ang_poses_piege <- mig_ang_poses_piege %>% rename(lot_tax_code = bjo_tax_code,lot_std_code = bjo_std_code)

