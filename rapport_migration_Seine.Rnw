  xlab("") + ylab("Nombre d'observations par heure") + guides(fill="none") +
    theme(
        text = element_text(size = 15),
        axis.text.x  = element_text(angle = -90, vjust = 0.5, hjust = 1),
        axis.title.y = element_text(angle = -90),
        axis.text.y = element_text(angle = -45,hjust=0.5)
    )
taille <- fn_taille_export(hhh)
png(
  file = str_c(imgwd, "p_horaires_trm.png"),
  width = taille$width,
  height = taille$height,
  units = "in",
  res = 200
)		
	print(p_horaires_trm)
  dev.off()

img <- image_read(file.path(imgwd, "p_horaires_trm.png")) %>%
  image_rotate(-90) %>%          # rotation 90°
  image_trim(fuzz = 1) %>%            # coupe les blancs (ajuste fuzz si besoin)
  image_border(color = "white", geometry = "15x15") 
  
image_write(img, path = file.path(imgwd, "p_horaires_trm.png"))

@

