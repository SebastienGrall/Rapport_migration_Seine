  group_by(station) %>%
  mutate(frequence = effectif / sum(effectif)*100) %>%
  ungroup() %>% mutate(annee=2000)

freq_taille_annee <- data_taille_agj %>% 
                      filter(annee == selected_annee) %>%
                      group_by(station,classe_taille) %>%
  summarise(effectif = n(), .groups = "drop")

freq_taille_annee <- freq_taille_annee %>%
  group_by(station) %>%
  mutate(frequence = effectif / sum(effectif)*100) %>%
  ungroup() %>% mutate(annee = selected_annee)

freq_taille_agj<-rbind(freq_taille_histo,freq_taille_annee)

plot_histo_taille_agj<-ggplot()+
  geom_bar(data=subset(freq_taille_agj,annee!=selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",alpha=0.5)+
  geom_bar(data=subset(freq_taille_agj,annee==selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",width=0.5)+
  facet_grid(rows=vars(station))+
                  scale_fill_manual(values = c("Poses" = col_Poses,
                                               "Pontoise" = col_Pontoise,
                                               "Carandeau" =  col_Carandeau
                                               ),
                                    drop = FALSE)+
  theme_bw()+ xlab("Classe de taille (mm)")+ylab("Proportion des classe de taille (%)")+
  scale_x_discrete(drop=FALSE)+
  theme(text = element_text(size = 15),axis.text.x = element_text(angle=45,vjust=0.5))+guides(fill="none")

png(file=str_c(imgwd,"plot_histo_taille_agj.png"),width=8,height=4,unit="in",res=200)
print(plot_histo_taille_agj)
dev.off()

