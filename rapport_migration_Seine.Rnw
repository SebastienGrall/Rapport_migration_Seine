    theme(text = element_text(size = 15)) + #,legend.position = "bottom")+ 
  scale_y_continuous(labels = scales::comma_format(accuracy = 1, scale = 1, prefix = "", suffix = "",  big.mark = " ", decimal.mark = "."))
png(file=str_c(imgwd,"plot_historique_lpf.png"),width=8,height=4,unit="in",res=200)
print(plot_historique_lpf)
