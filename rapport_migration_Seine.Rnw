<<chunk data bilan especes,echo=FALSE,eval=TRUE,results='hide'>>=

if(exists("con")){
# bilan espèces

bilesp<-new("report_species")
  bilesp<-choice_c(bilesp,
	  dc=c(101),
	  split="year", 
	  start_year=annee,
	  end_year=annee,
	  silent=FALSE)	
  bilesp <- connect(bilesp)
  bilesp <- calcule(bilesp)
bilesp_poses_vc_rg<-bilesp@data

bilesp<-new("report_species")
  bilesp<-choice_c(bilesp,
	  dc=c(103,105),
	  split="year", 
	  start_year=annee,
	  end_year=annee,
	  silent=FALSE)	
  bilesp <- connect(bilesp)
  bilesp <- calcule(bilesp)
bilesp_poses_vc_rd<-bilesp@data

bilesp<-new("report_species")
  bilesp<-choice_c(bilesp,
	  dc=c(106,107),
	  split="year", 
	  start_year=annee,
	  end_year=annee,
	  silent=FALSE)	
  bilesp <- connect(bilesp)
  bilesp <- calcule(bilesp)
bilesp_carandeau<-bilesp@data

bilesp<-new("report_species")
  bilesp<-choice_c(bilesp,
	  dc=c(108),
	  split="year", 
	  start_year=annee,
	  end_year=annee,
	  silent=FALSE)	
  bilesp <- connect(bilesp)
  bilesp <- calcule(bilesp)
bilesp_pontoise<-bilesp@data
}
