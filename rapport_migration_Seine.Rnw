<<chunk Truite de mer,echo=FALSE, eval=TRUE,results='hide'>>=

data_trm_poses<-data_trm[[1]]
data_trm_poses_annee<-subset(data_trm_poses@data,bjo_annee==annee & bjo_labelquantite=="Effectif_total")

data_trm_pontoise<- data_trm[[3]]
data_trm_pontoise_annee <- subset(data_trm_pontoise@data,bjo_annee==annee & bjo_labelquantite=="Effectif_total")

data_trm_carandeau <- data_trm[[2]]
data_trm_carandeau_annee <- subset(data_trm_carandeau@data,bjo_annee==annee & bjo_labelquantite=="Effectif_total")

#### plot annuelle TRM ####

data_trm_annuelle<-rbind(data_trm_poses_annee,data_trm_pontoise_annee,data_trm_carandeau_annee)
data_trm_annuelle <- data_trm_annuelle %>% mutate(station = case_when(
                            bjo_dis_identifiant %in% c(101,103,105)  ~ "Poses",
                            bjo_dis_identifiant %in% c(106,107)  ~ "Carandeau",
                            bjo_dis_identifiant == 108  ~ "Pontoise")) %>%
                        mutate(rive = case_when(
                            bjo_dis_identifiant == 101  ~ "Poses rive gauche",
                            bjo_dis_identifiant %in% c(103,105)  ~ "Poses rive droite",
                            bjo_dis_identifiant %in% c(106,107)  ~ "Carandeau",
                            bjo_dis_identifiant == 108  ~ "Pontoise")) 

data_trm_annuelle <- data_trm_annuelle %>% 
                        group_by(bjo_jour,station,rive) %>% 
                        summarise(bjo_valeur=sum(bjo_valeur))
data_trm_annuelle <- data_trm_annuelle %>%
                        mutate(station=factor(station,levels=c("Poses","Pontoise","Carandeau")))%>%
                        mutate(rive=factor(rive,levels=c("Poses rive gauche","Poses rive droite","Pontoise","Carandeau")))

plot_annuel_trm<-ggplot(data_trm_annuelle)+geom_bar(aes(x=bjo_jour,y=bjo_valeur,fill=rive),stat = "identity")+
                  facet_grid(rows=vars(station))+ xlab("")+ylab("Effectifs")+
                    scale_fill_manual(values = c("Poses rive gauche" = col_Poses_RG,
                                                 "Poses rive droite" = col_Poses_RD,
                                               "Pontoise" = col_Pontoise,
                                               "Carandeau" =  col_Carandeau
                                               ),
                                    drop = FALSE,
        breaks = c("Poses rive gauche", "Poses rive droite"),  # <-- Seuls ces deux apparaissent en légende
        name   = "Rive (Poses)",
        labels = c("Gauche", "Droite")
    ) +
                  theme_bw()+
                  theme(text = element_text(size = 15))+#guides(fill="none")+ 
  scale_y_continuous(labels = scales::comma_format(accuracy = 1, scale = 1, prefix = "", suffix = "",  big.mark = " ", decimal.mark = "."))

png(file=str_c(imgwd,"plot_annuel_trm.png"),width=8,height=4,unit="in",res=200)
print(plot_annuel_trm)
dev.off()

