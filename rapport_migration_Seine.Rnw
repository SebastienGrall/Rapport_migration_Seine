data_trm_pluri<-rbind(data_trm_poses@data,data_trm_pontoise@data,data_trm_carandeau@data)
data_trm_pluri<-subset(data_trm_pluri,bjo_labelquantite=="Effectif_total")
data_trm_pluri  <- data_trm_historique <- data_trm_pluri %>% mutate(station = case_when(
                            bjo_dis_identifiant %in% c(101,103,105)  ~ "Poses",
                            bjo_dis_identifiant %in% c(106,107)  ~ "Carandeau",
                            bjo_dis_identifiant == 108  ~ "Pontoise"))

data_trm_historique <- data_trm_historique %>% 
                        mutate(rive = case_when(
                            bjo_dis_identifiant == 101  ~ "Poses rive gauche",
                            bjo_dis_identifiant %in% c(103,105)  ~ "Poses rive droite",
                            bjo_dis_identifiant %in% c(106,107)  ~ "Carandeau",
                            bjo_dis_identifiant == 108  ~ "Pontoise")) %>%
                        group_by(bjo_annee,station,rive) %>% 
                        summarise(effectif=sum(bjo_valeur)) %>%
                        mutate(station=factor(station,levels=c("Poses","Pontoise","Carandeau"))) %>%
                        mutate(rive=factor(rive,levels=c("Poses rive gauche","Poses rive droite","Pontoise","Carandeau"))) %>%
  as.data.frame()

plot_historique_trm<- ggplot() +
    geom_bar(
        data = data_trm_historique,
