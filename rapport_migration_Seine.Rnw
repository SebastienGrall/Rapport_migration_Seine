freq_taille_mup<-rbind(freq_taille_histo,freq_taille_annee)

plot_histo_taille_mup<-ggplot()+
  geom_bar(data=subset(freq_taille_mup,annee!=selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",alpha=0.5)+
  geom_bar(data=subset(freq_taille_mup,annee==selected_annee),aes(x=classe_taille,y=frequence,fill=station),stat="identity",width=0.5)+
  #facet_grid(rows=vars(station))+
      scale_fill_manual(values = c("Poses" = col_Poses,
                                    "Pontoise" = col_Pontoise,
                                    "Carandeau" =  col_Carandeau
                                               ),
                                    drop = FALSE)+
  theme_bw()+ xlab("Classe de taille (mm)")+ylab("Proportion des classe de taille (%)")+
  scale_x_discrete(drop=FALSE)+
  theme(text = element_text(size = 15),axis.text.x = element_text(angle=45,vjust=0.5))+guides(fill="none")

