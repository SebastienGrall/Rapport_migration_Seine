<<chunk debit,echo=FALSE,eval=TRUE,results='hide'>>=
## Debit histo Seine ##

QmM<-get_hydrometrie_obs_elab(code_entite = "H320000104", grandeur_hydro_elab = "QmM")
QmM<-subset(QmM,date_obs_elab<=str_c(annee,"12-01"))
QmM$mois<-month(QmM$date_obs_elab)
QmM<-summarise(group_by(QmM,mois),Q_mean_month=round(mean(resultat_obs_elab/1000)))
QmM$mois<-as.Date(str_c(annee,"-",QmM$mois,"-01"),tz="GMT")

QmM_poly <- QmM %>%
  mutate(
    date_debut = as_date(mois),
    date_fin   = (as_date(mois) %m+% months(1)) - days(1),
    mois_centre = date_debut + (date_fin - date_debut) / 2   
  )

# Liste des breaks EXACTS (pas d'extra)
breaks_mois <- QmM_poly$mois_centre
labels_mois <- format(breaks_mois, "%b")  # noms des mois en français

QmnJ<-get_hydrometrie_obs_elab(code_entite = "H320000104",date_debut_obs_elab = str_c(annee,"-01-01"),
                               date_fin_obs_elab = str_c(annee,"-12-31"),grandeur_hydro_elab = "QmnJ")
QmnJ$resultat_obs_elab<-QmnJ$resultat_obs_elab/1000
QmnJ$date_obs_elab<-as.Date(QmnJ$date_obs_elab)

debit_seine_histo<-ggplot() +
  geom_rect(
    data = QmM_poly,
    aes(
      xmin = date_debut,
      xmax = date_fin,
      ymin = 0,
      ymax = Q_mean_month
    ),
    fill = "#2C80D3", alpha = 0.8, color = NA
  )+
  geom_line(data = QmnJ,
            aes(x = date_obs_elab, y = resultat_obs_elab),
            color = "black", linewidth = 1) +

    scale_x_date(
    breaks = breaks_mois,
    labels = labels_mois,
    expand = c(0,0)
  ) +
  labs(x = "", y = bquote(bold('débits ('* ~ m^3/s*')')),title = "Débits de la Seine") +
  theme_bw()+
    theme(
    axis.text = element_text(size = 15),
    axis.title.y = element_text(size = 15),
    legend.position = "right",
    legend.title = element_blank(),
    legend.text = element_text(size = 15)
  ) + 
  scale_y_continuous(labels = scales::comma_format(accuracy = 1, scale = 1, prefix = "", suffix = "",  big.mark = " ", decimal.mark = "."))

## Debit histo Oise ##

