                           ))%>% ungroup() %>% select(4,3)


mig_annee_carandeau<-subset(bilesp_carandeau,tax_nom_latin %in% c("Anguilla anguilla","Alosa","Salmo trutta trutta","Salmo salar",
                           "Lampetra fluviatilis","Petromyzon marinus","Chelon ramada"))
mig_annee_carandeau<-summarise(group_by(mig_annee_carandeau,lot_tax_code,lot_std_code),effectifs_carandeau=sum(lot_effectif))
mig_annee_carandeau<- mig_annee_carandeau %>% mutate(Espèces = case_when(
                            #lot_tax_code == "2038" & lot_std_code =="CIV" ~ "Anguille en montaison (passe piège)",
                            lot_tax_code == "2038" & lot_std_code =="4" ~ "Anguille jaune (vidéo-comptage)",
                            lot_tax_code == "2038" & lot_std_code =="AGG" ~ "Anguille argentée",
                            lot_tax_code == "2011" & lot_std_code =="5" ~ "Lamproie fluviatile",
                            lot_tax_code == "2014" & lot_std_code =="5" ~ "Lamproie marine",
                            lot_tax_code == "2055" & lot_std_code =="5" ~ "Alose",
                            lot_tax_code == "2183" & lot_std_code =="5" ~ "Mulet porc",
                            lot_tax_code == "2220" & lot_std_code =="5" ~ "Saumon atlantique",
                            lot_tax_code == "2224" & lot_std_code =="5" ~ "Truite de mer"
                           )) %>% ungroup() %>% select(4,3)

resume_poses<-full_join(mig_annee_poses_rg,mig_annee_poses_rd,by=c("Espèces")) %>%
  rowwise(Espèces) %>% 
  mutate(total_poses = sum(c(effectifs_poses_rg,effectifs_poses_rd),na.rm = T))

resume <-resume_poses %>% full_join(mig_annee_pontoise,by=c("Espèces")) %>% 
  full_join(mig_annee_carandeau,by=c("Espèces"))

resume<-resume %>% rename("Poses rive gauche" = effectifs_poses_rg, "Poses rive droite" = effectifs_poses_rd, "Total Poses" = total_poses,
                  "Pontoise" = effectifs_pontoise, "Carandeau" = effectifs_carandeau) %>% as.data.frame()
rownames(resume)<-resume[,1]
resume<-select(resume,-1) 

resume<-resume[c("Alose","Anguille en montaison (passe piège)","Anguille jaune (vidéo-comptage)","Anguille argentée","Lamproie fluviatile",
          "Lamproie marine","Mulet porc","Saumon atlantique","Truite de mer"),]

resume2 <- resume %>%
  tibble::rownames_to_column(var = "Espèce") %>%
  mutate(across(where(is.numeric), ~replace_na(.x, 0)))

resume2[2:6]<-format(resume2[2:6],big.mark = " ")

resume2 <- resume2 %>%
  mutate(
    Pontoise  = if_else(`Espèce` == "Anguille en montaison (passe piège)", "", Pontoise),
    Carandeau = if_else(`Espèce` == "Anguille en montaison (passe piège)", "", Carandeau)) %>%
   rename(Espèces = Espèce)

resume_latex <- resume2 %>%
  kbl(
    caption = "Effectifs annuels des poissons migrateurs comptabilisés sur les stations de contrôle des migrations du bassin de la Seine",
    booktabs = TRUE,
    format = "latex",
    escape = FALSE,
    linesep = "",
    label = "recap"
  ) %>%
  kable_styling(
    latex_options = c("striped","hold_position", "scale_down"),
    position = "center",
    full_width = FALSE
  ) %>%
  column_spec(1, width = "6cm") %>%
  column_spec(2, latex_column_spec = "C{2cm}", bold = F) %>%
  column_spec(3, latex_column_spec = "C{2cm}", bold = F) %>%
  column_spec(4, latex_column_spec = "C{2cm}", bold = TRUE) %>%
  column_spec(5, latex_column_spec = "C{2cm}", bold = TRUE) %>%
  column_spec(6, latex_column_spec = "C{2cm}", bold = TRUE) %>%
  add_header_above(c(" " = 1, "Seine" = 3, "Oise" = 1, "Aisne" = 1))

writeLines(resume_latex, str_c(tabwd, "recap.tex"))

@


Les poissons migrateurs entrant dans l'estuaire de la Seine sont contrôlés au niveau du barrage de Poses, marquant la fin de l'estuaire et qui est équipé de dispositifs de comptage sur les deux rives. Les poissons qui s'engagent sur l'axe Oise peuvent ensuite être retrouvés au niveau du barrage de Pontoise, équipé d'un système de vidéo-comptage depuis 2023. Il existe un dernier point de contrôle pour les poissons empruntant ensuite l'Aisne au niveau du barrage de Carandeau. Les effectifs comptabilisés en \Sexpr{annee} au niveau de ces stations sont présentés dans le tableau \ref{tab:recap}.


\input{table/recap.tex}


