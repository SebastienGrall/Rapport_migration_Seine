# A function factory for getting integer y-axis values.
integer_breaks <- function(n = 5, ...) {
    fxn <- function(x) {
        breaks <- floor(pretty(x, n, ...))
        names(breaks) <- attr(breaks, "labels")
        breaks
    }
    return(fxn)
}

fn_horaires<-function(espece=c("Alosa")){
  horaires_esp_poses_vc_rg<-subset(bilesp_poses_vc_rg,tax_nom_latin==espece)
  if(nrow(horaires_esp_poses_vc_rg)>0){horaires_esp_poses_vc_rg$station<-"Poses"}
  horaires_esp_poses_vc_rd<-subset(bilesp_poses_vc_rd,tax_nom_latin==espece)
  if(nrow(horaires_esp_poses_vc_rd)>0){horaires_esp_poses_vc_rd$station<-"Poses"}
  horaires_esp_pontoise<-subset(bilesp_pontoise,tax_nom_latin==espece)
  if(nrow(horaires_esp_pontoise)>0){horaires_esp_pontoise$station<-"Pontoise"}
  horaires_esp_carandeau<-subset(bilesp_carandeau,tax_nom_latin==espece)
  if(nrow(horaires_esp_carandeau)>0){horaires_esp_carandeau$station<-"Carandeau"}
  
  horaires_esp<-rbind(horaires_esp_poses_vc_rg,horaires_esp_poses_vc_rd,horaires_esp_pontoise,horaires_esp_carandeau)
  return(horaires_esp)
}

## on définit la taille de l'export du plot horaires en fonction du nombre de station
fn_taille_export <- function(data){
  n <- length(unique(data$station))
  
  if (n == 3) return(list(width = 15, height = 10))
  if (n == 2) return(list(width = 10, height = 7))
  if (n == 1) return(list(width = 5, height = 3.5))
}

####### Fonction bilan  DC et DF ######

fndc<-function(le_dc=c(104)){
  r_dc=new("report_dc")
  r_dc<-choice_c(r_dc,
                 le_dc,
                 horodatedebut=str_c(annee,"-01-01"),
                 horodatefin=str_c(annee,"-12-31"),
                 silent=TRUE)
  Sys.setenv(TZ='GMT')
  report_dc<-connect(r_dc)
}

fndf<-function(le_df=c(1)){
  r_df=new("report_df")
  r_df<-choice_c(r_df,
                 le_df,
                 horodatedebut=str_c(annee,"-01-01"),
                 horodatefin=str_c(annee,"-12-31"),
                 silent=TRUE)
  Sys.setenv(TZ='GMT')
  report_df<-connect(r_df)
}
