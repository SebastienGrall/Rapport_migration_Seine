r_sample_char<-new("report_sample_char")
r_sample_char<-choice_c(r_sample_char,
                        dc=c(101,103,105,108),
                        taxa=c("Alosa","Anguilla anguilla","Lampetra fluviatilis","Petromyzon marinus",
                               "Chelon ramada","Salmo salar","Salmo trutta trutta"),
                        stage=c("5","AGG","4"),
                        par=c("C001"),
                        horodatedebut="2008-01-01",
                        horodatefin=str_c(annee,"-12-31"),
                        silent=TRUE)
r_sample_char<-connect(r_sample_char)
r_sample_char<-calcule(r_sample_char,silent=TRUE)
report_sample_char=get("report_sample_char",envir_stacomi)
data_taille_video<-report_sample_char@data

r_sample_char<-new("report_sample_char")
r_sample_char<-choice_c(r_sample_char,
                        dc=c(102,104),
                        taxa=c("Anguilla anguilla"),
                        stage=c(4),
                        par=c("1786"),
                        horodatedebut="2014-01-01",
                        horodatefin=str_c(annee,"-12-31"),
                        silent=TRUE)
r_sample_char<-connect(r_sample_char)
r_sample_char<-calcule(r_sample_char,silent=TRUE)
report_sample_char=get("report_sample_char",envir_stacomi)
data_taille_ang_piege<-report_sample_char@data
}
